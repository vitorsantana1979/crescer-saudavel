# Copie este arquivo para .env (na raiz do repositório) e preencha os valores.
# O .env NÃO é versionado (.gitignore). Nunca coloque valores reais neste .env.example.
#
# Quem lê o .env:
#   - docker compose (docker-compose.yml, docker-compose.production.yml, docker-compose.prod.yml)
#   - scripts/run-api.sh (traduz para ConnectionStrings__DefaultConnection, Jwt__Key, OpenAI__ApiKey)
#   - ml-service (pydantic-settings lê ml-service/.env e ../.env)
#   - scripts/*.ts (via `set -a; source .env; set +a` antes de rodar)
# Valores com espaços ou caracteres especiais: coloque entre aspas simples.

# ---- SQL Server (backend, ml-service e scripts/) ----
# Host e porta no formato aceito pelo SQL Server: host,porta
DATABASE_SERVER=
DATABASE_NAME=crescer
DATABASE_USER=
DATABASE_PASSWORD=

# ---- Backend (.NET) ----
# Chave de assinatura dos JWT (HS256): string aleatória com pelo menos 32 bytes.
# Gere com: openssl rand -base64 48
JWT_KEY=
# Senha do SuperAdmin criado no primeiro start (opcional; vazio usa a senha padrão de desenvolvimento,
# que é pública no repositório — defina em qualquer ambiente real).
SEED_SUPERADMIN_PASSWORD=

# ---- OpenAI (Chat IA; opcional — sem valor o chat responde "não configurado") ----
OPENAI_API_KEY=

# ---- Somente docker-compose.production.yml ----
VITE_API_URL=
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5280"]
